{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Halo",
  "version": "0.2.2",
  "identifier": "app.codexhalo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "Codex Halo",
        "width": 100,
        "height": 100,
        "minWidth": 100,
        "minHeight": 100,
        "maxWidth": 344,
        "maxHeight": 364,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "backgroundColor": "#00000000"
      },
      {
        "label": "panel",
        "title": "Codex Halo",
        "url": "index.html?view=panel",
        "width": 384,
        "height": 668,
        "minWidth": 384,
        "minHeight": 668,
        "maxWidth": 384,
        "maxHeight": 668,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false,
        "backgroundColor": "#00000000"
      }
    ],
    "macOSPrivateApi": true,
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Codex quota at a glance",
    "longDescription": "A lightweight floating desktop card for Codex usage limits.",
    "copyright": "Copyright Codex Halo contributors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
